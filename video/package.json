{
  "name": "chaospilot-video",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Remotion motion graphics overview for ChaosPilot",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "studio": "remotion studio src/index.ts",
    "render": "node --import tsx/esm scripts/render.ts",
    "validate": "node --import tsx/esm scripts/validate.ts"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.541"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
